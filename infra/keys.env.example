# secrets/keys.env 의 틀:  mkdir -p secrets && cp infra/keys.env.example secrets/keys.env && chmod 600 secrets/keys.env
# 값은 채팅·문서·커밋에 쓰지 말고 이 파일에만 넣으세요. 확인은 ./infra/check_keys.sh (값은 출력 안 함)

# 네이버 클라우드 API 인증키 (콘솔 › 마이페이지 › 계정 관리 › 인증키 관리)
NCLOUD_ACCESS_KEY=
NCLOUD_SECRET_KEY=

# CLOVA Speech 장문 인식 도메인의 연동 정보 (Invoke URL, Secret Key)
CLOVA_SPEECH_INVOKE_URL=
CLOVA_SPEECH_SECRET=

# Hugging Face 읽기 토큰 (pyannote 모델 약관 동의 필요)
HF_TOKEN=

# 선택: CLOVA Studio
CLOVASTUDIO_API_KEY=
