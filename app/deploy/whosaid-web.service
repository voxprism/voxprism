[Unit]
Description=VoxPrism web (FastAPI)
After=network-online.target

[Service]
User=whosaid
Group=whosaid
EnvironmentFile=/etc/whosaid.env
WorkingDirectory=/opt/whosaid/app
ExecStart=/opt/whosaid/venv/bin/uvicorn whosaid.web.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
